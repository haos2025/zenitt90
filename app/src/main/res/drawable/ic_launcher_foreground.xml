<?xml version="1.0" encoding="utf-8"?>
<!-- РЕДИЗАЙН ИКОНКИ (по запросу Shadow — концепт 3, "орбита с точкой
     зенита + play"): весь рисунок умещён внутри safe zone адаптивной
     иконки (круг диаметром 66dp в центре холста 108×108 — безопасная
     область, которая не обрежется ни одной маской лаунчера — круглой,
     квадратной со скруглением, "squircle" и т.д.). Раньше foreground был
     растровым PNG с НЕПРОЗРАЧНЫМ фоном (вся сцена целиком) — это ломало
     саму идею адаптивной иконки (фон не мог просвечивать, параллакс между
     слоями не работал). Здесь — честный прозрачный foreground, три формы:
     дуга "орбиты" с разрывом сверху, точка в высшей точке (сам "зенит" —
     положение над головой), треугольник воспроизведения по центру. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <path
        android:pathData="M62.21,35.44 A24,24 0 1,1 45.79,35.44"
        android:strokeColor="#4FD1FF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:fillColor="#00000000"/>
    <path
        android:pathData="M49.4,29.5 A4.6,4.6 0 1,1 58.6,29.5 A4.6,4.6 0 1,1 49.4,29.5 Z"
        android:fillColor="#EAF6FF"/>
    <path
        android:pathData="M46,47 L46,69 L67,58 Z"
        android:fillColor="#EAF6FF"/>
</vector>
