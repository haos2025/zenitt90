<?xml version="1.0" encoding="utf-8"?>
<!-- Только debug-сборка: отдельный значок «Whisper замер» рядом с приложением.
     Нужен для замера скорости локального Whisper на реальной приставке.
     В release-сборку не попадает. Удалить вместе с папкой src/debug,
     когда замеры не нужны. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="com.platinum.ott.debugtools.WhisperBenchActivity"
            android:exported="true"
            android:label="Whisper замер"
            android:icon="@mipmap/ic_launcher"
            android:banner="@drawable/tv_banner"
            android:theme="@style/Theme.Zenith.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
